# ---------------------------------------------------------------------------
# Copy to .env at the repo root. Every app reads from this single file.
# ---------------------------------------------------------------------------

# --- Database -------------------------------------------------------------
POSTGRES_USER=sbta
POSTGRES_PASSWORD=sbta
POSTGRES_DB=sbta
POSTGRES_PORT=5433
# Integration tests truncate tables, so they run against their own database.
TEST_DATABASE_URL=postgresql://sbta:sbta@localhost:5433/sbta_test?schema=public
DATABASE_URL=postgresql://sbta:sbta@localhost:5433/sbta?schema=public

# --- Server ---------------------------------------------------------------
PORT=4310
NODE_ENV=development
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:4320

# Shared secret the gateway presents as `Authorization: Bearer <token>`.
GATEWAY_TOKEN=dev-gateway-token-change-me

# Default queue drain interval, seeded into the settings row on first run.
# Runtime changes are made through the dashboard and persist in the database.
DEFAULT_SEND_INTERVAL_SECONDS=3600

# How long a claimed message stays leased before the reaper requeues it.
LEASE_SECONDS=120

# --- Gateway --------------------------------------------------------------
# `mock` simulates the full lifecycle on timers and needs no macOS permissions.
# `applescript` sends real iMessages and requires Full Disk Access.
GATEWAY_DRIVER=mock
GATEWAY_ID=local-gateway
SERVER_URL=http://localhost:4310
GATEWAY_POLL_WAIT_SECONDS=25

# Mock driver timings (milliseconds between simulated lifecycle steps).
MOCK_STEP_MS=1200
MOCK_FAILURE_RATE=0

# --- Web ------------------------------------------------------------------
VITE_API_URL=http://localhost:4310
