// The queue of record.
//
// Postgres owns every piece of durable state in this system. The gateway
// transport is deliberately dumb -- it carries work and carries reports back,
// but it never holds the queue. That single decision is what removes the
// dual-write problem a message broker would have introduced.

generator client {
  provider = "prisma-client-js"
  output   = "../src/db/generated"
}

// Prisma 7 moved the connection URL out of the schema: migrations read it from
// prisma.config.ts, and the runtime client gets it through a driver adapter.
datasource db {
  provider = "postgresql"
}

enum MessageStatus {
  QUEUED
  DISPATCHING
  ACCEPTED
  SENT
  DELIVERED
  RECEIVED
  FAILED
  CANCELED
}

model Message {
  id String @id @default(uuid())

  /// Monotonic FIFO order. Deliberately not createdAt: two messages created in
  /// the same millisecond would tie, and a tie in a FIFO queue is a bug.
  queueSeq BigInt @default(autoincrement())

  /// The iMessage recipient: an E.164 phone number or an Apple ID email.
  /// Normalized once at the HTTP edge so the queue, the gateway and chat.db
  /// correlation all compare the same string.
  toHandle String
  body     String

  status MessageStatus @default(QUEUED)

  /// Operator override: "send now" sets this, which makes the message jump the
  /// queue and bypass the rate gate exactly once. Cleared when it is claimed.
  /// Kept separate from `priority` so the override is explicit in the data and
  /// cannot be confused with a future prioritisation policy.
  forceDispatch Boolean @default(false)

  /// Reserved for future scheduling policies. The FIFO policy ignores both.
  /// Two nullable columns now turn "support timestamped sends" from a migration
  /// into a configuration change later.
  scheduledAt DateTime?
  priority    Int       @default(0)

  /// Identifies one dispatch attempt. A status report carrying a stale token --
  /// from an attempt the reaper already reclaimed -- is rejected rather than
  /// applied to the newer attempt.
  dispatchToken String? @unique

  /// While held, the message is invisible to other claims. Past this instant the
  /// reaper returns it to QUEUED. This is where delivery reliability lives.
  leaseExpiresAt DateTime?

  attempts Int @default(0)

  /// The chat.db GUID of the real iMessage. Doubles as the double-send guard:
  /// the gateway refuses to invoke osascript when this is already set, because
  /// sending an iMessage cannot be undone.
  providerGuid String? @unique

  lastError String?

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  dispatchedAt DateTime?
  sentAt       DateTime?
  deliveredAt  DateTime?
  receivedAt   DateTime?

  events MessageEvent[]

  /// The FIFO claim, in exactly its sort order. Without the matching directions
  /// Postgres sorts every queued row to pick one.
  @@index([status, forceDispatch(sort: Desc), queueSeq])

  /// The TIMESTAMPED policy's ordering. Unused by the default policy, but its
  /// presence is what makes switching policy a config change rather than a
  /// migration.
  @@index([status, forceDispatch(sort: Desc), scheduledAt, priority, queueSeq])

  /// The reaper: expired leases.
  @@index([status, leaseExpiresAt])

  /// `max(dispatchedAt)` feeds the rate gate and is read on every lease poll.
  /// Without this it is a sequential scan of the whole table.
  @@index([dispatchedAt(sort: Desc)])

  /// The dashboard list, newest first, filtered and unfiltered.
  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@map("messages")
}

/// Append-only audit log. Powers the per-message timeline on the dashboard and
/// makes the system explainable after the fact -- which is most of what
/// "overall visibility" means in practice.
model MessageEvent {
  id        String        @id @default(uuid())
  messageId String
  status    MessageStatus
  detail    Json?

  /// When the gateway *observed* the change, which is not when the server
  /// recorded it. Both are kept.
  occurredAt DateTime @default(now())
  recordedAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  /// Makes replay harmless: a redelivered report collides and is discarded
  /// rather than duplicating a row in the timeline.
  @@unique([messageId, status])
  @@index([messageId, occurredAt])
  @@map("message_events")
}

/// Single-row configuration table. The drain interval lives here rather than in
/// an env var because the assessment asks for it to be configurable, and a
/// reviewer changing it to 10 seconds in the dashboard can watch the whole
/// system work in under a minute.
model Setting {
  id                  Int      @id @default(1)
  sendIntervalSeconds Int      @default(3600)
  policy              String   @default("FIFO")
  paused              Boolean  @default(false)

  /// How many times a message may be dispatched before it stays FAILED. The
  /// rate limiter spaces the retries, so this needs no backoff of its own.
  maxAttempts         Int      @default(3)
  updatedAt           DateTime @updatedAt

  @@map("settings")
}

/// Liveness for the dashboard. The gateway dials out, so the server never
/// connects to it and can only know it is alive because it recently asked for work.
model GatewayHeartbeat {
  id         String   @id
  driver     String
  version    String
  lastSeenAt DateTime @default(now())

  /// What the gateway can actually do. Null for drivers that need no macOS
  /// permissions, which is how the UI knows not to nag about the mock.
  fullDiskAccess Boolean?
  automation     Boolean?
  hostApp        String?

  @@map("gateway_heartbeats")
}

/// The address book. `handle` is the identity: normalized exactly like
/// `Message.toHandle`, so a message joins to its recipient by that string alone
/// and nothing has to be kept in sync -- delete a recipient and its history
/// simply loses the name, never the messages.
model Recipient {
  id        String   @id @default(uuid())
  name      String
  handle    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@map("recipients")
}
