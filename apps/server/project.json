{
  "name": "server",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/server/src",
  "projectType": "application",
  "implicitDependencies": [
    "shared"
  ],
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "sh -c 'set -a; [ -f ../../.env ] && . ../../.env; set +a; exec tsx watch src/main.ts'",
        "cwd": "apps/server"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "db:generate"
      ],
      "options": {
        "command": "node build.mjs",
        "cwd": "apps/server"
      },
      "outputs": [
        "{projectRoot}/dist"
      ]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "db:generate"
      ],
      "options": {
        "command": "tsc -p apps/server/tsconfig.json --noEmit"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint apps/server/src"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "db:generate"
      ],
      "options": {
        "command": "sh -c 'set -a; [ -f ../../.env ] && . ../../.env; set +a; cd ../.. && exec vitest run --root apps/server --project unit'",
        "cwd": "apps/server"
      }
    },
    "test:integration": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "db:generate"
      ],
      "options": {
        "command": "sh -c 'set -a; [ -f ../../.env ] && . ../../.env; set +a; export DATABASE_URL=\"${TEST_DATABASE_URL:-$DATABASE_URL}\"; cd ../.. && exec vitest run --root apps/server --project integration'",
        "cwd": "apps/server"
      },
      "cache": false
    },
    "db:generate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "sh -c 'set -a; [ -f ../../.env ] && . ../../.env; set +a; exec prisma generate'",
        "cwd": "apps/server"
      },
      "outputs": [
        "{projectRoot}/src/db/generated"
      ],
      "cache": true
    },
    "db:migrate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "sh -c 'set -a; [ -f ../../.env ] && . ../../.env; set +a; exec prisma migrate dev'",
        "cwd": "apps/server"
      },
      "cache": false
    },
    "db:deploy": {
      "executor": "nx:run-commands",
      "options": {
        "command": "sh -c 'set -a; [ -f ../../.env ] && . ../../.env; set +a; exec prisma migrate deploy'",
        "cwd": "apps/server"
      },
      "cache": false
    },
    "db:seed": {
      "executor": "nx:run-commands",
      "options": {
        "command": "sh -c 'set -a; [ -f ../../.env ] && . ../../.env; set +a; exec tsx prisma/seed.ts'",
        "cwd": "apps/server"
      },
      "cache": false
    },
    "db:studio": {
      "executor": "nx:run-commands",
      "options": {
        "command": "sh -c 'set -a; [ -f ../../.env ] && . ../../.env; set +a; exec prisma studio'",
        "cwd": "apps/server"
      },
      "cache": false
    },
    "db:migrate:test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "sh -c 'set -a; [ -f ../../.env ] && . ../../.env; set +a; export DATABASE_URL=\"$TEST_DATABASE_URL\"; exec prisma migrate deploy'",
        "cwd": "apps/server"
      },
      "cache": false
    }
  },
  "tags": [
    "scope:server",
    "type:app"
  ]
}
