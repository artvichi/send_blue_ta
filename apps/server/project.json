{
  "name": "server",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/server/src",
  "projectType": "application",
  "implicitDependencies": [
    "shared"
  ],
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "../../scripts/with-env.sh tsx watch src/main.ts",
        "cwd": "apps/server"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "db:generate"
      ],
      "options": {
        "command": "node build.mjs",
        "cwd": "apps/server"
      },
      "outputs": [
        "{projectRoot}/dist"
      ]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "db:generate"
      ],
      "options": {
        "command": "tsc -p apps/server/tsconfig.json --noEmit"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint apps/server/src"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "db:generate"
      ],
      "options": {
        "command": "./scripts/with-env.sh npx vitest run --root apps/server --project unit",
        "cwd": "."
      }
    },
    "test:integration": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "db:generate"
      ],
      "options": {
        "command": "./scripts/with-env.sh sh -c 'export DATABASE_URL=\"${TEST_DATABASE_URL:-$DATABASE_URL}\"; exec npx vitest run --root apps/server --project integration'",
        "cwd": "."
      },
      "cache": false
    },
    "db:generate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "../../scripts/with-env.sh prisma generate",
        "cwd": "apps/server"
      },
      "outputs": [
        "{projectRoot}/src/db/generated"
      ],
      "cache": true
    },
    "db:migrate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "../../scripts/with-env.sh prisma migrate dev",
        "cwd": "apps/server"
      },
      "cache": false
    },
    "db:deploy": {
      "executor": "nx:run-commands",
      "options": {
        "command": "../../scripts/with-env.sh prisma migrate deploy",
        "cwd": "apps/server"
      },
      "cache": false
    },
    "db:seed": {
      "executor": "nx:run-commands",
      "options": {
        "command": "../../scripts/with-env.sh tsx prisma/seed.ts",
        "cwd": "apps/server"
      },
      "cache": false
    },
    "db:studio": {
      "executor": "nx:run-commands",
      "options": {
        "command": "../../scripts/with-env.sh prisma studio",
        "cwd": "apps/server"
      },
      "cache": false
    },
    "db:migrate:test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "../../scripts/with-env.sh sh -c 'export DATABASE_URL=\"$TEST_DATABASE_URL\"; exec prisma migrate deploy'",
        "cwd": "apps/server"
      },
      "cache": false
    }
  },
  "tags": [
    "scope:server",
    "type:app"
  ]
}
