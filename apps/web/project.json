{
  "name": "web",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/web/src",
  "projectType": "application",
  "implicitDependencies": ["shared"],
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "options": { "command": "vite", "cwd": "apps/web" }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": { "command": "vite build", "cwd": "apps/web" },
      "outputs": ["{projectRoot}/dist"]
    },
    "preview": {
      "executor": "nx:run-commands",
      "options": { "command": "vite preview", "cwd": "apps/web" }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": { "command": "tsc -p apps/web/tsconfig.json --noEmit" }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": { "command": "eslint apps/web/src" }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": { "command": "vitest run --root apps/web --passWithNoTests" }
    }
  },
  "tags": ["scope:web", "type:app"]
}
