<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The gateway as a user LaunchAgent: starts at login, restarts on crash, keeps
  running after the terminal that installed it is closed.

  Installed by scripts/gateway-install.sh, which fills in the placeholders.
  A LaunchAgent (not a LaunchDaemon) because Messages.app and chat.db belong to
  the logged-in user, and TCC grants are per user.

  Permissions: under launchd there is no terminal app to hold the grant, so
  Full Disk Access and Automation must be granted to the node binary named in
  ProgramArguments -- the one case where "add node" is the right answer.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.sbta.gateway</string>

  <key>ProgramArguments</key>
  <array>
    <string>__NODE__</string>
    <string>__REPO__/apps/gateway/dist/main.js</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__REPO__/apps/gateway</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>GATEWAY_DRIVER</key>
    <string>applescript</string>
    <key>SERVER_URL</key>
    <string>__SERVER_URL__</string>
    <key>GATEWAY_TOKEN</key>
    <string>__GATEWAY_TOKEN__</string>
    <key>GATEWAY_ID</key>
    <string>__GATEWAY_ID__</string>
    <key>PATH</key>
    <string>/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <!-- launchd sends SIGTERM; the gateway finishes its current send first. -->
  <key>ExitTimeOut</key>
  <integer>15</integer>
  <key>ThrottleInterval</key>
  <integer>5</integer>

  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/sbta-gateway.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/sbta-gateway.log</string>
</dict>
</plist>
