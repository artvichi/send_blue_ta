# macOS
.DS_Store

# Editors / IDEs
.idea/
.vscode/
*.swp

# Environment
.env
.env.*
!.env.example

# Logs
*.log
logs/

# Dependencies / build output
node_modules/
dist/
build/
coverage/
.nx/
vite.config.*.timestamp*

# Prisma generated client
libs/**/generated/
apps/**/generated/

# Compiled output must never sit beside sources: a stale .js next to its .ts
# silently shadows the real module. (A tsc run once emitted these into libs/.)
libs/**/src/**/*.js
apps/**/src/**/*.js

# Terraform
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!example.tfvars
.terraform.lock.hcl

# Gateway runtime scratch
.gateway-cache/
