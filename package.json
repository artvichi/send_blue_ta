{
  "name": "@sb/source",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@10.9.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "nx run-many -t build",
    "db:down": "docker compose down",
    "db:generate": "nx run server:db:generate",
    "db:migrate": "nx run server:db:migrate",
    "db:migrate:test": "nx run server:db:migrate:test",
    "db:seed": "nx run server:db:seed",
    "db:setup": "npm run db:up && npm run db:migrate && npm run db:test:create && npm run db:migrate:test",
    "db:studio": "nx run server:db:studio",
    "db:test:create": "docker compose exec -T postgres psql -U sbta -d postgres -c 'CREATE DATABASE sbta_test OWNER sbta' || true",
    "db:up": "docker compose up -d postgres",
    "dev": "nx run-many -t serve -p server web --output-style=stream",
    "dev:all": "nx run-many -t serve -p server web gateway --output-style=stream",
    "gateway:mock": "GATEWAY_DRIVER=mock nx run gateway:serve",
    "gateway:real": "GATEWAY_DRIVER=applescript nx run gateway:serve",
    "gateway:setup": "tsx apps/gateway/src/setup.ts",
    "lint": "nx run-many -t lint",
    "test": "nx run-many -t test",
    "test:int": "nx run server:test:integration",
    "typecheck": "nx run-many -t typecheck",
    "verify": "nx run-many -t typecheck lint test"
  },
  "devDependencies": {
    "@nx/eslint": "23.2.1",
    "@types/node": "22.15.3",
    "@typescript-eslint/eslint-plugin": "8.70.0",
    "@typescript-eslint/parser": "8.70.0",
    "esbuild": "0.28.2",
    "eslint": "9.17.0",
    "nx": "23.2.1",
    "prettier": "3.4.2",
    "tsx": "4.19.2",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  },
  "workspaces": [
    "apps/*",
    "libs/*"
  ]
}
