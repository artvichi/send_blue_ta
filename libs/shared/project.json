{
  "name": "shared",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/shared/src",
  "projectType": "library",
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "options": { "command": "tsc -p libs/shared/tsconfig.json --noEmit" }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": { "command": "eslint libs/shared/src" }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": { "command": "vitest run --root libs/shared" }
    }
  },
  "tags": ["scope:shared", "type:lib"]
}
