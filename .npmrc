auto-install-peers=true
strict-peer-dependencies=false

# The Prisma client is generated into apps/server/src/db/generated -- outside
# node_modules -- so its `require('@prisma/client-runtime-utils')` cannot reach
# @prisma/client's private dependencies under pnpm's strict layout. Hoisting the
# Prisma packages to the root makes them resolvable from the generated code.
public-hoist-pattern[]=@prisma/*
public-hoist-pattern[]=prisma
